# Copy this file to `.env` and fill in the values before running:
#   cp .env.example .env
# Never commit the real `.env` file or a real JWT_SECRET.

# REQUIRED — shared HS512 signing key, base64-encoded, at least 64 bytes (512 bits).
# Generate a fresh one with:
#   openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_BASE64_SECRET

# Optional overrides (defaults shown)
JWT_EXPIRATION_MS=3600000
JWT_COOKIE_NAME=FinLedger
JWT_COOKIE_HTTPONLY=true
# Set to true when the app is served over HTTPS.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGIN=http://localhost:5173